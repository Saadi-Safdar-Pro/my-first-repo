# =====================================================
# Repo-wide common ignores (deduplicated)
# =====================================================

# ============================
# OS and Temp Files
# ============================
*.swp
*.tmp
*.temp
*.bak
*.backup
*.cache
*.log
.DS_Store
Thumbs.db

# ============================
# Editors / IDEs
# ============================
.vscode/
.idea/
*.code-workspace

# VSCode-specific temp / workspace files
.history/
*.workspace

# ============================
# Python
# ============================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/
.env/

# Jupyter
.ipynb_checkpoints/

# ============================
# Node / Web Dev
# ============================
node_modules/
dist/
build/

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================
# C/C++ Build Files
# ============================
*.o
*.out
*.obj
*.exe
*.dll
*.so
*.a
*.lo
*.la
*.class
*.jar

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# ============================
# Logs / Temporary files
# ============================
*.zip
*.tar.gz
*.7z
*.rar
*.iso

# Backups / old files
*.old
*.orig

# ============================
# Git
# ============================
.gitignore_global

